{
  "name": "gpt-jungle-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:python",
    "dev": "vite",
    "verify:python": "node scripts/verify-source-manifest.mjs",
    "manifest:update": "node scripts/update-source-manifest.mjs",
    "build:python": "node scripts/build-python-archive.mjs",
    "build": "npm run build:python && tsc -b && vite build",
    "build:e2e": "npm run build:python && tsc -b && cross-env VITE_ENABLE_TEST_HOOKS=true vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python -m pytest tests/python -q",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:public": "playwright test --config playwright.public.config.ts",
    "test:all": "npm run verify:python && npm run test:python && npm run lint && npm test && npm run build && npm run test:e2e",
    "deploy": "wrangler pages deploy dist --project-name gpt-jungle --branch main"
  },
  "dependencies": {
    "pyodide": "314.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.10.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "jsdom": "27.4.0",
    "jszip": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
