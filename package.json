{
  "name": "gpt-jungle-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:engine",
    "dev": "vite",
    "verify:python": "node scripts/verify-source-manifest.mjs",
    "manifest:update": "node scripts/update-source-manifest.mjs",
    "build:engine": "node scripts/release-engine.mjs",
    "build": "npm run build:engine && tsc -b && vite build && node scripts/build-host.mjs && node scripts/package-release.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:rust": "cargo fmt --manifest-path engine/Cargo.toml --all -- --check && cargo clippy --locked --manifest-path engine/Cargo.toml --workspace --all-targets -- -D warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python -m pytest tests/python -q",
    "test:rust": "cargo test --locked --manifest-path engine/Cargo.toml --workspace",
    "test:artifacts": "node scripts/test-release.mjs",
    "benchmark:legacy": "python -m tools.web_ai_benchmark",
    "benchmark:ai": "node scripts/benchmark-release.mjs",
    "test:e2e": "node scripts/browser-release.mjs",
    "test:public": "cross-env PLAYWRIGHT_BASE_URL=https://gpt-jungle.pages.dev node scripts/browser-release.mjs --target public --browsers chrome,edge,firefox,webkit",
    "test:all": "npm run verify:release && npm run build && npm run verify:python && npm run test:python && npm run lint:rust && npm run test:rust && npm run lint && npm test && npm run test:release && npm run test:e2e && npm run test:controls",
    "predeploy": "npm run build",
    "deploy": "wrangler pages deploy dist --project-name gpt-jungle --branch main",
    "test:release": "node scripts/test-release.mjs",
    "conformance": "node scripts/serve-host.mjs",
    "verify:release": "node scripts/verify-committed.mjs",
    "test:controls": "node scripts/browser-controls.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@bytecodealliance/jco-transpile": "0.24.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.10.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "cross-env": "10.1.0",
    "esbuild": "0.27.3",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "jsdom": "27.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
